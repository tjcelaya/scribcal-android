<?xml version="1.0" encoding="utf-8"?><!--
    One row of the voice result sheet: a running event in the status answer, or a candidate
    event type when a spoken name matched more than one.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <View
        android:id="@+id/voiceOptionDot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/circle_background"
        android:backgroundTint="?attr/colorPrimary" />

    <TextView
        android:id="@+id/voiceOptionText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
        android:textColor="?android:attr/textColorPrimary"
        tools:text="Exercise · 42m" />

</LinearLayout>
