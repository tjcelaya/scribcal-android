<?xml version="1.0" encoding="utf-8"?>
<!--
  Swipe-to-delete draws behind this row, so the root needs an opaque background.

  The event-type colour that used to live in a 12dp dot is now carried by the timeline gutter
  (LedgerTimelineDecoration), which reserves a column to the left of this row.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    android:background="?android:attr/colorBackground"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="12dp"
    android:paddingEnd="8dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/eventTypeName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
            android:textColor="?android:attr/textColorPrimary"
            tools:text="Exercise" />

        <!--
          The action cluster to the right is a fixed ~96dp, so everything on this line has to be
          told how to give way: only the time range flexes (and ellipsizes), the duration and the
          sync icon keep their intrinsic size. Leaving all three at wrap_content is what used to
          crush the sync badge into a one-character-per-line column.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/timeRangeText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="11:20 PM – 11:33 PM" />

            <TextView
                android:id="@+id/durationText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                tools:text="42m" />

            <!--
              An icon rather than the old "In calendar" text: the label is the icon's
              contentDescription, so TalkBack still reads it while nothing can wrap.
            -->
            <ImageView
                android:id="@+id/syncBadge"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="8dp"
                tools:src="@drawable/ic_event_available"
                tools:ignore="ContentDescription" />

        </LinearLayout>

        <TextView
            android:id="@+id/notesText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:textColor="?android:attr/textColorSecondary"
            android:visibility="gone"
            tools:text="Morning run"
            tools:visibility="visible" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/extendButton"
            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@string/ledger_action_extend"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            app:icon="@drawable/ic_schedule"
            app:iconSize="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/adjustButton"
            style="@style/Widget.Material3.Button.IconButton.Outlined"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/ledger_action_adjust"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            app:icon="@drawable/ic_edit"
            app:iconSize="18dp" />

    </LinearLayout>

</LinearLayout>
