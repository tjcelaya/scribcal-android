<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <!-- Color Indicator -->
    <View
        android:id="@+id/colorIndicator"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/circle_background"
        tools:backgroundTint="?attr/colorPrimary" />

    <!-- Event Type Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/eventTypeName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
            android:textColor="?android:attr/textColorPrimary"
            tools:text="Exercise" />

        <TextView
            android:id="@+id/eventTypeDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="?android:attr/textColorSecondary"
            android:visibility="gone"
            tools:text="Daily workout sessions"
            tools:visibility="visible" />

        <!-- Ongoing Event Status -->
        <LinearLayout
            android:id="@+id/ongoingStatusLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/elapsedTimeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                tools:text="00:15:32" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="•"
                android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/startedAtText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Started at 2:30 PM" />

        </LinearLayout>

    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Instant Event Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/instantEventButton"
            style="@style/Widget.Material3.Button.IconButton.Outlined"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="Record Instant Event"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            app:icon="@drawable/ic_flash"
            app:iconSize="18dp" />

        <!-- Start Event Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/startEventButton"
            style="@style/Widget.Material3.Button.IconButton.Filled"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="Start Event"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            app:icon="@drawable/ic_play"
            app:iconSize="18dp" />

        <!-- Stop Event Button (shown when event is ongoing) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/stopEventButton"
            style="@style/Widget.Material3.Button.IconButton.Outlined"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="Stop Event"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:visibility="gone"
            app:icon="@drawable/ic_stop"
            app:iconSize="18dp"
            app:strokeColor="?attr/colorError"
            app:iconTint="?attr/colorError"
            tools:visibility="visible" />

    </LinearLayout>

</LinearLayout>
