<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:text="Record New Event"
        android:textAppearance="?attr/textAppearanceHeadline5"
        android:textAlignment="center" />

    <!-- Event Type Input -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:orientation="vertical">
        
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Event Type"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginBottom="8dp" />
        
        <AutoCompleteTextView
            android:id="@+id/eventTypeAutoComplete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:completionThreshold="1"
            android:hint="Type or select an event type"
            android:background="@drawable/text_input_underline_selector"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:textAppearance="?attr/textAppearanceBodyLarge" />
            
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Type or select an event type"
            android:textAppearance="?attr/textAppearanceCaption"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginTop="4dp" />
            
    </LinearLayout>

    <!-- Date Time Input -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:orientation="vertical">
        
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Date &amp; Time"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginBottom="8dp" />
        
        <TextView
            android:id="@+id/dateTimeDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/text_input_underline_selector"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:drawableEnd="@drawable/ic_calendar_today"
            android:drawablePadding="12dp" />
            
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tap to select date and time for the event"
            android:textAppearance="?attr/textAppearanceCaption"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginTop="4dp" />
            
    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="24dp">

        <Button
            android:id="@+id/recordInstantEventButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Save Right Now"
            android:textAppearance="?attr/textAppearanceButton"
            android:paddingVertical="16dp"
            app:icon="@drawable/ic_flash"
            app:iconGravity="start"
            style="@style/Widget.Material3.Button" />

        <Button
            android:id="@+id/startTimedEventButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Start Timed Event"
            android:textAppearance="?attr/textAppearanceButton"
            android:paddingVertical="16dp"
            app:icon="@drawable/ic_play"
            app:iconGravity="start"
            style="@style/Widget.Material3.Button.OutlinedButton" />

    </LinearLayout>

    <!-- Help Text -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="• Instant Event: Records a zero-duration event at the selected date/time\n• Timed Event: Starts a stopwatch at the selected date/time\n• New event types are automatically created when you enter them"
        android:textAppearance="?attr/textAppearanceCaption"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:padding="16dp" />

    <!-- Spacer to push cancel button to bottom -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Cancel Button -->
    <Button
        android:id="@+id/cancelButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cancel"
        android:textAppearance="?attr/textAppearanceButton"
        android:paddingVertical="16dp"
        style="@style/Widget.Material3.Button.TextButton" />

</LinearLayout>