<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.CalWrite" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Use CalWrite blue colors as fallback -->
        <item name="colorPrimary">@color/calwrite_blue</item>
        <item name="colorPrimaryVariant">@color/calwrite_blue_dark</item>
        <item name="colorSecondary">@color/calwrite_blue_light</item>
        <item name="colorAccent">@color/calwrite_blue</item>
    </style>

    <style name="Theme.CalWrite" parent="Base.Theme.CalWrite" />

    <!-- Translucent theme for notification dialog activity -->
    <style name="Theme.CalWrite.Translucent" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
